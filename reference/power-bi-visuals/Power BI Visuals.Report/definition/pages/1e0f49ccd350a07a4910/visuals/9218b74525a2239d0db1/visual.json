            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Title Total Sales Top Segment = \n        VAR _Summary =\n            SUMMARIZECOLUMNS(\n                ''Financials''[Segment],\n                \"Total Sales\", [Total Sales]\n            )\n        VAR _TopSegment =\n            TOPN(\n                1,\n                _Summary,\n                [Total Sales],\n                DESC\n            )\n        VAR _SegmentName =\n            MAXX(\n                _TopSegment,\n                ''Financials''[Segment]\n            )\n        VAR _TopSales =\n            MAXX(\n                _TopSegment,\n                [Total Sales]\n            )\n        // Total sales in the current filter context (all segments combined)\n        VAR _TotalSales =\n            [Total Sales]\n        RETURN\n            IF(\n                ISBLANK(_SegmentName),\n                // Fallback when no segment is available\n                \"Total sales is \"\n                    & FORMAT(_TotalSales, \"$#,0\"),\n                // Main pattern: \"[segment] ($#) is the top segment and total sales is $#\"\n                _SegmentName\n                    & \" (\"\n                    & FORMAT(_TopSales, \"$#,0\")\n                    & \") is the top segment and total sales is \"\n                    & FORMAT(_TotalSales, \"$#,0\")\n            )'"
                }
              }
            }
          }
        }
