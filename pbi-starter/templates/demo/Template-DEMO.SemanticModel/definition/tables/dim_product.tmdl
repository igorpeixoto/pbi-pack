/// Products: one row per product. Category lives in dim_category, which filters both sales and targets.
table dim_product
	lineageTag: aa8e56bb-d17a-4db7-84ac-ed6bc682e539

	/// Product key, e.g. P0042.
	column 'Product ID'
		dataType: string
		lineageTag: 2259f41d-5837-4ccd-a6ac-d583efa3cb3f
		summarizeBy: none
		sourceColumn: Product ID

		annotation SummarizationSetBy = Automatic

	/// Product display name.
	column 'Product Name'
		dataType: string
		lineageTag: 96092d51-5b40-46ef-97db-b5e150c81661
		summarizeBy: none
		sourceColumn: Product Name

		annotation SummarizationSetBy = Automatic

	/// Product subcategory, e.g. Cookware. Each subcategory belongs to exactly one category.
	column Subcategory
		dataType: string
		lineageTag: fff48479-62aa-4f01-a74e-fb188db2d654
		summarizeBy: none
		sourceColumn: Subcategory

		annotation SummarizationSetBy = Automatic

	/// 2023 list price. Order prices rise 3% a year after 2023.
	column 'List Price'
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 47392330-a91e-49ef-b45c-b23bd230a33f
		summarizeBy: none
		sourceColumn: List Price

		annotation SummarizationSetBy = Automatic

	/// Cost of one unit. Line cost in fact_sales is quantity × this value.
	column 'Unit Cost'
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: b20dc722-8ac2-4406-bc3d-99f9dd259ece
		summarizeBy: none
		sourceColumn: Unit Cost

		annotation SummarizationSetBy = Automatic

	partition dim_product = m
		mode: import
		queryGroup: Model
		source =
				let
					// Typed, guarded products from staging
					Source = stg_products,
					// Category is left out on purpose: dim_category carries it, so one category filter reaches sales and targets alike
					SelectedColumns = Table.SelectColumns(Source, {"product_id", "product_name", "subcategory", "list_price", "unit_cost"}),
					// Friendly names for the field list
					Renamed = Table.RenameColumns(SelectedColumns, {
						{"product_id", "Product ID"},
						{"product_name", "Product Name"},
						{"subcategory", "Subcategory"},
						{"list_price", "List Price"},
						{"unit_cost", "Unit Cost"}
					})
				in
					Renamed

	annotation PBI_ResultType = Table

