model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup Functions

	annotation PBI_QueryGroupOrder = 1

queryGroup Staging

	annotation PBI_QueryGroupOrder = 2

queryGroup Model

	annotation PBI_QueryGroupOrder = 3

queryGroup 'Data Quality'

	annotation PBI_QueryGroupOrder = 4

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["dim_category","dim_customer","dim_date","dim_product","fact_sales","fact_targets","DataFolder","_Source","_IsJunk","_ScrubJunk","_AssertUniqueKey","_AssertTyped","_AssertRequired","raw_orders","stg_orders","stg_customers","stg_products","stg_targets","_DataQualityIssues","_Measures"]

ref table dim_category
ref table dim_customer
ref table dim_date
ref table dim_product
ref table fact_sales
ref table fact_targets
ref table _Measures

ref cultureInfo en-US

