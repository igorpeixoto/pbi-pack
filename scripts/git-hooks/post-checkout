#!/bin/sh
# Git post-checkout hook: refresh everything this pack installs under ~/.claude/ after switching
# onto main.
#
# This file is the tracked source of truth. Install with: sh scripts/install-hooks.sh
#
# Args: $1 = previous HEAD, $2 = new HEAD, $3 = 1 for a branch checkout / 0 for a file checkout.
#
# Guarded to main on purpose — see the note in post-merge. Switching AWAY to a feature branch
# deliberately does nothing, so the globally-installed copies stay at main's version; switching
# back to main re-syncs.

prev="$1"
new="$2"
is_branch_checkout="$3"

[ "$is_branch_checkout" = "1" ] || exit 0

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ROOT" || exit 0

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")
[ "$branch" = "main" ] || exit 0

# On a fresh clone the previous HEAD is all zeros — sync everything in that case.
case "$prev" in
    0000000*) CHANGED="ALL" ;;
    *)        CHANGED=$(git diff --name-only "$prev" "$new") ;;
esac

sh scripts/sync-home.sh "Git Hook" "$CHANGED"
