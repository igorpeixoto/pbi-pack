createOrReplace

	/// Sample data of software-project tasks (start, end, progress, dependencies) for Gantt visual demos.
	table 'Gantt software project'
		

		/// Marker measure used for the Gantt chart demo.
		measure FabCon = DATE(2025, 3, 15)
			formatString: General Date
			

		/// The start date of the task, rolling up to start date of category or entire project.
		measure 'Start date' = MIN('Gantt software project'[Start])
			formatString: dd mmm yyyy
			

			annotation PBI_FormatHint = {"isCustom":true}

		/// For the task to show as a milestone, the end date should return blank.
		measure 'End date' =
				IF(
							[Start date] == MAX('Gantt software project'[End]),
							BLANK(),
							MAX('Gantt software project'[End])
						)
			formatString: dd mmm yyyy
			

			annotation PBI_FormatHint = {"isCustom":true}

		/// The percentage of the task that is completed.
		measure 'Progress %' =
				DIVIDE(
							AVERAGE('Gantt software project'[Progress]),
							100
						)
			formatString: #,0%;-#,0%;#,0%
			

		column 'Task ID'
			formatString: 0
			
			summarizeBy: count
			isNameInferred
			sourceColumn: [Task ID]

			annotation SummarizationSetBy = Automatic

		column Task
			
			summarizeBy: none
			isNameInferred
			sourceColumn: [Task]

			annotation SummarizationSetBy = Automatic

		column Category
			
			summarizeBy: none
			isNameInferred
			sourceColumn: [Category]

			annotation SummarizationSetBy = Automatic

		column Start
			formatString: General Date
			
			summarizeBy: none
			isNameInferred
			sourceColumn: [Start]

			annotation SummarizationSetBy = Automatic

		column End
			formatString: General Date
			
			summarizeBy: none
			isNameInferred
			sourceColumn: [End]

			annotation SummarizationSetBy = Automatic

		column Progress
			formatString: 0
			
			summarizeBy: sum
			isNameInferred
			sourceColumn: [Progress]

			annotation SummarizationSetBy = Automatic

		column Dependencies
			
			summarizeBy: none
			isNameInferred
			sourceColumn: [Dependencies]

			annotation SummarizationSetBy = Automatic

		partition 'Gantt software project' = calculated
			mode: import
			source = ```
					
					VAR TaskTable = 
						{
							( 1, "Project Kickoff", "Planning", DATE(2025,1,6), DATE(2025,1,6), 100, "" ),
							( 2, "Requirements Gathering", "Planning", DATE(2025,1,7), DATE(2025,1,17), 100, "1" ),
							( 3, "Technical Specification", "Planning", DATE(2025,1,13), DATE(2025,1,24), 75, "2" ),
							( 4, "Architecture Review", "Planning", DATE(2025,1,27), DATE(2025,1,27), 0, "3" ),
							( 5, "Database Design", "Development", DATE(2025,1,28), DATE(2025,2,7), 50, "4" ),
							( 6, "API Development", "Development", DATE(2025,2,3), DATE(2025,2,21), 25, "5" ),
							( 7, "Frontend Development", "Development", DATE(2025,2,10), DATE(2025,2,28), 10, "5" ),
							( 8, "Integration", "Development", DATE(2025,2,24), DATE(2025,3,7), 0, "6,7" ),
							( 9, "Unit Testing", "Testing", DATE(2025,2,17), DATE(2025,3,7), 0, "6" ),
							( 10, "Integration Testing", "Testing", DATE(2025,3,10), DATE(2025,3,21), 0, "8,9" ),
							( 11, "User Acceptance Testing", "Testing", DATE(2025,3,24), DATE(2025,4,4), 0, "10" ),
							( 12, "Production Deployment", "Deployment", DATE(2025,4,7), DATE(2025,4,11), 0, "11" ),
							( 13, "Go Live", "Deployment", DATE(2025,4,14), DATE(2025,4,14), 0, "12" )
						}
					RETURN
						SELECTCOLUMNS(
							TaskTable,
							"Task ID", [Value1],
							"Task", [Value2],
							"Category", [Value3],
							"Start", [Value4],
							"End", [Value5],
							"Progress", [Value6],
							"Dependencies", [Value7]
						)
					```

		annotation PBI_Id = 657a62e9dd4d4163b3e3542df33e4502